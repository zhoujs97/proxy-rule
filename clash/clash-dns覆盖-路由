dns:
  enable: true
  listen: ':53'

  # === Fake-IP ===
  enhanced-mode: 'fake-ip'
  fake-ip-range: '198.18.0.1/16'
  fake-ip-range6: 'fdfe:dcba:9876::1/64'
  fake-ip-filter-mode: 'blacklist'

  # === DNS 基础行为 ===
  prefer-h3: false
  respect-rules: true
  use-hosts: false
  use-system-hosts: false
  ipv6: false

  # === Fake-IP 排除 ===
  # Apple / iCloud 不使用 Fake-IP
  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - '*.arpa'
    - 'time.*.com'
    - 'ntp.*.com'
    - 'time.*.com'
    - '+.market.xiaomi.com'
    - 'localhost.ptlogin2.qq.com'
    - '*.msftncsi.com'
    - 'www.msftconnecttest.com'
    - '*.lan'

    # Apple
    - '*.apple.com'
    - '*.apple.com.cn'
    - '*.icloud.com'
    - '*.icloud.com.cn'
    - '*.icloud-content.com'
    - '*.me.com'
    - '*.mac.com'

  # === 默认 DNS ===
  # 未特别指定的域名默认使用国际 DNS
  default-nameserver:
    - '1.1.1.1'
    - '8.8.8.8'

  nameserver:
    - 'https://1.1.1.1/dns-query'
    - 'https://cloudflare-dns.com/dns-query'

  # ============================================================
  # Apple DNS 分流
  # ============================================================
  # Apple / iCloud 域名明确使用国内 DNS。
  #
  # 这样：
  # Apple DNS → 国内 DNS
  # Apple 网络连接 → 由你的 Rule 中的 DIRECT 决定
  #
  # 其他没有命中这里的域名 → 默认 Cloudflare DoH
  # ============================================================
  nameserver-policy:
    '+.apple.com':
      - '223.5.5.5'
      - '119.29.29.29'

    '+.apple.com.cn':
      - '223.5.5.5'
      - '119.29.29.29'

    '+.icloud.com':
      - '223.5.5.5'
      - '119.29.29.29'

    '+.icloud.com.cn':
      - '223.5.5.5'
      - '119.29.29.29'

    '+.icloud-content.com':
      - '223.5.5.5'
      - '119.29.29.29'

    '+.me.com':
      - '223.5.5.5'
      - '119.29.29.29'

    '+.mac.com':
      - '223.5.5.5'
      - '119.29.29.29'

  # === DIRECT DNS ===
  # 保留你原来的配置，不在第一阶段改变。
  direct-nameserver-follow-policy: false

  direct-nameserver:
    - 'https://doh.pub/dns-query'
    - '223.5.5.5'

  # === Fallback ===
  fallback-filter:
    geoip: true
    geoip-code: 'CN'

    ipcidr:
      - '240.0.0.0/4'
      - '0.0.0.0/32'

    domain:
      - '+.google.com'
      - '+.facebook.com'
      - '+.youtube.com'

  fallback:
    - 'https://cloudflare-dns.com/dns-query'

  # === Proxy 节点自身的域名解析 ===
  # 保持原配置，避免代理节点域名解析受到 Apple DNS 分流影响
  proxy-server-nameserver:
    - '223.5.5.5'
    - '119.29.29.29'
